{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EnableSwagger": true,
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_HOST;Port=5432;Database=YOUR_DB;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require"
  },
  "Jwt": {
    "SecretKey": "YOUR_LONG_RANDOM_JWT_SECRET",
    "Issuer": "ECommerceAPI",
    "Audience": "ECommerceUsers",
    "ExpirationMinutes": 1440
  },
  "Supabase": {
    "Url": "https://YOUR_PROJECT.supabase.co",
    "AnonKey": "YOUR_SUPABASE_ANON_KEY",
    "JwtSecret": "YOUR_SUPABASE_JWT_SECRET",
    "ServiceRoleKey": "YOUR_SUPABASE_SERVICE_ROLE_KEY"
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": "587",
    "Username": "your-email@example.com",
    "Password": "YOUR_APP_PASSWORD",
    "FromEmail": "your-email@example.com",
    "FromName": "YourApp"
  },
  "AiService": {
    "BaseUrl": "https://your-ai-service.example.com",
    "Endpoints": {
      "CategorySuggestion": "/api/ai/suggest-category",
      "TagSuggestion": "/api/ai/suggest-tags",
      "MaterialSuggestion": "/api/ai/suggest-materials"
    },
    "TimeoutSeconds": 30,
    "ApiKey": ""
  },
  "FrontendUrl": "http://localhost:3000",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "MoMo": {
    "PartnerCode": "MOMO",
    "AccessKey": "YOUR_MOMO_ACCESS_KEY",
    "SecretKey": "YOUR_MOMO_SECRET_KEY",
    "ApiUrl": "https://test-payment.momo.vn/v2/gateway/api/create",
    "ReturnUrl": "https://your-api.example.com/api/payments/momo/return",
    "NotifyUrl": "https://your-api.example.com/api/payments/momo/ipn",
    "RequestType": "payWithMethod"
  },
  "GHN": {
    "BaseUrl": "https://dev-online-gateway.ghn.vn",
    "Token": "YOUR_GHN_TOKEN",
    "ShopId": "YOUR_SHOP_ID"
  },
  "Orders": {
    "DefaultEstimatedDeliveryDays": 4
  },
  "PlatformFee": {
    "CommissionPercent": 10
  },
  "VNPay": {
    "TmnCode": "YOUR_VNPAY_TMN_CODE",
    "HashSecret": "YOUR_VNPAY_HASH_SECRET",
    "Url": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "https://your-api.example.com/api/payments/vnpay/return",
    "Version": "2.1.0",
    "Command": "pay",
    "CurrCode": "VND",
    "Locale": "vn"
  }
}
